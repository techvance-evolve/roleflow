# Copia este archivo a .env (nunca se sube al repo) y completa tus keys.
# El setup interactivo lo hace por ti: npm run setup
# NUNCA pongas keys reales en el repo público.

# Z.ai (GLM Coding Plan: planner glm-5.3 + GLM Pro)
ZAI_API_KEY=

# OpenCode Go / Go Plus (pool barato: flash, k2.7-code, qwen-plus)
OPENCODE_GO_API_KEY=

# (Opcional) Zen pay-as-you-go como buffer de picos
OPENCODE_ZEN_API_KEY=
