# Copia este archivo a .env (nunca se sube al repo) y completa tus keys.
# El setup interactivo lo hace por ti: npm run setup
# NUNCA pongas keys reales en el repo público.
# Nombres nativos de OpenCode (el plugin no mapea nada).

# Z.ai (GLM Coding Plan: planner glm-5.3 + flash)
# Provider nativo: zai-coding-plan
ZAI_API_KEY=

# OpenCode Go / pool (incluye Zen; mismo env nativo para ambos providers)
# Providers nativos: opencode-go, opencode
OPENCODE_API_KEY=
