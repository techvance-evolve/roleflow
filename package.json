{
  "name": "roleflow",
  "version": "1.0.5",
  "description": "Roleflow: sistema OpenCode portable con roles por responsabilidad + routing barato + ahorro de tokens. Público, instalable desde cualquier PC o server con una línea en opencode.json.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "agents",
    "skills",
    "scripts",
    "postinstall.mjs",
    "preuninstall.mjs",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "postinstall": "node postinstall.mjs",
    "preuninstall": "node preuninstall.mjs",
    "setup": "node scripts/setup.mjs",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.9.0"
  },
  "license": "MIT",
  "author": "Manuel Rodrigues (Techvance Evolve)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techvance-evolve/roleflow.git"
  },
  "keywords": ["opencode", "opencode-plugin", "ai", "agents", "glm", "kimi"]
}
